; N-queens, all solutions counted, plus the first one printed
(define (queens board-size)
  (define (ok? row dist placed)
    (or (null? placed)
        (and (not (= (car placed) (+ row dist)))
             (not (= (car placed) (- row dist)))
             (not (= (car placed) row))
             (ok? row (+ dist 1) (cdr placed)))))
  (define (try k placed)
    (if (= k 0)
        (list placed)
        (apply append
               (map (lambda (row) (if (ok? row 1 placed) (try (- k 1) (cons row placed)) '()))
                    (iota board-size 1)))))
  (try board-size '()))
(define sols (queens 8))
(display (length sols)) (newline)
(write (car sols)) (newline)
; primes with a sieve vector
(define (sieve n)
  (let ((v (make-vector (+ n 1) #t)))
    (let loop ((i 2) (acc '()))
      (cond ((> i n) (reverse acc))
            ((vector-ref v i)
             (do ((j (* i i) (+ j i))) ((> j n)) (vector-set! v j #f))
             (loop (+ i 1) (cons i acc)))
            (else (loop (+ i 1) acc))))))
(define ps (sieve 20000))
(display (list (length ps) (list-ref ps 1000) (fold-left + 0 ps))) (newline)
; association-list "database" and string building
(define people '(("ada" 36 "london") ("alan" 41 "wilmslow") ("grace" 85 "arlington")))
(for-each (lambda (p) (display (string-append (car p) " is " (number->string (cadr p)) " from " (caddr p))) (newline)) people)
(display (exact->inexact (/ (fold-left + 0 (map cadr people)) (length people)))) (newline)
; Collatz chain lengths, longest chain under 5000
(define (collatz-len n)
  (let loop ((n n) (len 1)) (if (= n 1) len (loop (if (even? n) (quotient n 2) (+ (* 3 n) 1)) (+ len 1)))))
(define (longest limit)
  (let loop ((i 1) (best 0) (arg 0))
    (if (> i limit) (list arg best)
        (let ((l (collatz-len i))) (if (> l best) (loop (+ i 1) l i) (loop (+ i 1) best arg))))))
(write (longest 5000)) (newline)
