; tail calls in constant stack
(define (count-down n) (if (= n 0) 'done (count-down (- n 1))))
(display (count-down 1000000)) (newline)
(define (even2? n) (if (= n 0) #t (odd2? (- n 1))))
(define (odd2? n) (if (= n 0) #f (even2? (- n 1))))
(display (even2? 100001)) (newline)
(define (sum-to n) (do ((i 0 (+ i 1)) (s 0 (+ s i))) ((> i n) s)))
(display (sum-to 100000)) (newline)
; deep non-tail recursion
(define (build n) (if (= n 0) '() (cons n (build (- n 1)))))
(display (length (build 20000))) (newline)
; closures and counters
(define (make-counter)
  (let ((n 0)) (lambda () (set! n (+ n 1)) n)))
(define c1 (make-counter)) (define c2 (make-counter))
(c1) (c1) (c2)
(display (list (c1) (c2))) (newline)
; escape continuations
(define (find-first pred lst)
  (call/ec (lambda (return)
    (for-each (lambda (x) (when (pred x) (return x))) lst)
    #f)))
(display (list (find-first even? '(1 3 6 7 8)) (find-first even? '(1 3)))) (newline)
(define (product lst)
  (call/ec (lambda (k) (fold-left (lambda (acc x) (if (= x 0) (k 'zero) (* acc x))) 1 lst))))
(display (list (product '(1 2 3 4)) (product '(1 0 (error "never"))))) (newline)
; error handling
(define (safe-div a b)
  (with-exception-handler
    (lambda (e) (list 'caught (error-object-message e) (error-object-irritants e)))
    (lambda () (if (= b 0) (error "divide by zero:" a) (/ a b)))))
(write (list (safe-div 10 4) (safe-div 1 0))) (newline)
(write (with-exception-handler (lambda (e) (list 'raised e)) (lambda () (+ 1 (raise 'oops))))) (newline)
(write (with-exception-handler (lambda (e) (error-object-message e)) (lambda () (vector-ref (vector 1 2) 5)))) (newline)
(write (with-exception-handler (lambda (e) (error-object-message e)) (lambda () (undefined-thing)))) (newline)
(define log '())
(define (note x) (set! log (cons x log)))
(with-exception-handler (lambda (e) 'ignored)
  (lambda () (dynamic-wind (lambda () (note 'in)) (lambda () (error "boom")) (lambda () (note 'out)))))
(write (reverse log)) (newline)
; named let, case, cond =>, delay
(write (let loop ((i 0) (acc '())) (if (= i 5) (reverse acc) (loop (+ i 1) (cons (* i i) acc))))) (newline)
(write (map (lambda (x) (case x ((1 2 3) 'small) ((10 20) 'big) (else 'other))) '(2 20 7))) (newline)
(write (cond ((assq (quote b) (quote ((a 1) (b 2)))) => cadr) (else (quote no)))) (newline)
(define p (delay (begin (display "[computing]") 42)))
(write (list (force p) (force p))) (newline)
(define-syntax-missing 1)
