(define xs (iota 10 1))
(write xs) (newline)
(write (map (lambda (x) (* x x)) xs)) (newline)
(write (map + '(1 2 3) '(10 20 30) '(100 200 300))) (newline)
(write (filter odd? xs)) (newline)
(write (fold-left + 0 xs)) (newline)
(write (fold-right cons '() xs)) (newline)
(write (reduce max 0 '(3 9 2 7))) (newline)
(write (assoc "b" '(("a" . 1) ("b" . 2)))) (newline)
(write (assq 'c '((a 1) (b 2)))) (newline)
(write (append '(1 2) '(3) '() '(4 5 . 6))) (newline)
(write `(1 ,(+ 1 1) ,@(map (lambda (x) (* 10 x)) '(3 4)) (nested ,(car xs)) . end)) (newline)
(write '(quote a)) (write ''b) (write '`(c ,d ,@e)) (newline)
(write (sort '(5 3 9 1 5 0 -2) <)) (newline)
(write (sort (list "pear" "apple" "fig") string<?)) (newline)
(write (list->string (map char-upcase (string->list "hello, world")))) (newline)
(write (string-split "a,b,,c" ",")) (newline)
(write (string-join (list "x" "y" "z") " + ")) (newline)
(write (list #\a #\space #\newline "tab\there" "quote\"d" 'sym 1.5 #t #f '())) (newline)
(display (list #\a #\space "tab\there" "quote\"d")) (newline)
(define v (make-vector 5 'x))
(vector-set! v 2 '(1 2))
(write v) (write (vector-length v)) (write (vector-map (lambda (e) (if (symbol? e) 0 e)) v)) (newline)
(define h (make-hash-table))
(for-each (lambda (w) (hash-table-set! h w (+ 1 (hash-table-ref/default h w 0))))
          '("the" "cat" "the" "hat" "the" "end" "cat"))
(write (map (lambda (k) (cons k (hash-table-ref h k))) (hash-table-keys h))) (newline)
(hash-table-delete! h "the")
(write (hash-table-count h)) (newline)
(define-values-test 1)
