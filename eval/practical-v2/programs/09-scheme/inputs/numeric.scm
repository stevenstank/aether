; exact numeric tower
(define (fact n) (if (= n 0) 1 (* n (fact (- n 1)))))
(display (fact 20)) (newline)
(display (fact 21)) (newline)
(display (fact 100)) (newline)
(define (fib n) (let loop ((a 0) (b 1) (i 0)) (if (= i n) a (loop b (+ a b) (+ i 1)))))
(display (fib 90)) (newline)
(display (fib 300)) (newline)
(display (/ 1 3)) (newline)
(display (+ (/ 1 3) (/ 2 3))) (newline)
(display (* (/ 22 7) 7)) (newline)
(display (/ 6 -4)) (newline)
(display (exact->inexact (/ 1 3))) (newline)
(display (inexact->exact 0.1)) (newline)
(display (expt 2 100)) (newline)
(display (expt (/ 2 3) 5)) (newline)
(display (expt 2 -3)) (newline)
(display (expt 2.0 0.5)) (newline)
(display (sqrt 144)) (display " ") (display (sqrt 2)) (display " ") (display (sqrt (expt 10 40))) (newline)
(display (list (quotient 17 5) (remainder 17 5) (modulo 17 5) (quotient -17 5) (remainder -17 5) (modulo -17 5) (modulo 17 -5))) (newline)
(display (modulo (expt 7 222) 1000007)) (newline)
(display (- 9223372036854775807 -1)) (newline)
(display (+ 9223372036854775807 1)) (newline)
