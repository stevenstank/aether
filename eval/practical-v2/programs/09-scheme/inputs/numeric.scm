(display (* -4611686018427387904 2)) (newline)
(display (- (- 9223372036854775807) 2)) (newline)
(display (quotient (expt 10 30) (expt 10 28))) (newline)
(display (list (exact? 1/2) (exact? 0.5) (integer? 4.0) (integer? 1/2) (rational? 1/2))) (newline)
(display (list (numerator 6/4) (denominator 6/4) (floor 7/2) (floor -7/2) (round 2.5) (round 3.5))) (newline)
(display (list 1e21 1.5e-7 (/ 1.0 3) (* 1.0 0) (/ 1.0 0) (- (/ 1.0 0)) 100.0 -0.0)) (newline)
(display (list (number->string 255 16) (number->string (expt 2 70) 2) (string->number "1/3") (string->number "12345678901234567890") (string->number "x"))) (newline)
(display (gcd 1071 462)) (display " ") (display (lcm 21 6)) (newline)
